source "https://rubygems.org"

# Local preview of this GitHub Pages site.
# `github-pages` pins Jekyll and the plugin set (jekyll-optional-front-matter,
# jekyll-readme-index, kramdown, etc.) to the same versions GitHub Pages uses,
# so `bundle exec jekyll serve` renders these front-matter-less Markdown files
# the same way the deployed site does.
gem "github-pages", group: :jekyll_plugins

# Fixes for newer Ruby (3.x) where these were removed from the standard library.
gem "webrick"
